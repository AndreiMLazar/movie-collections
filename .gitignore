# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ──────────────────────────────────────────────────────────────
# Angular / TypeScript build outputs
# ──────────────────────────────────────────────────────────────
/dist
/out-tsc
/tmp
/bazel-out
*.tsbuildinfo

# ──────────────────────────────────────────────────────────────
# Angular CLI cache
# ──────────────────────────────────────────────────────────────
/.angular/cache
.sass-cache/

# ──────────────────────────────────────────────────────────────
# Node
# ──────────────────────────────────────────────────────────────
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────────────────────────
# Testing
# ──────────────────────────────────────────────────────────────
/coverage
testem.log
__screenshots__/

# ──────────────────────────────────────────────────────────────
# Environment / secrets
# ──────────────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.*.local
!.env.example

# Auto-generated from .env by scripts/set-env.js — never commit
src/environments/environment.development.ts

# ──────────────────────────────────────────────────────────────
# IDEs and editors
# ──────────────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VS Code — share settings/tasks/launch/extensions but not personal overrides
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# ──────────────────────────────────────────────────────────────
# System files
# ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────────────────────
# Miscellaneous legacy artifacts
# ──────────────────────────────────────────────────────────────
/connect.lock
/libpeerconnection.log
/typings
